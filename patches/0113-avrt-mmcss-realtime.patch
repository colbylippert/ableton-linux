+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <errno.h>
+#include <unistd.h>
+#include <sched.h>
+#ifdef __linux__
+# include <sys/syscall.h>
+#endif
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+
+#include "unixlib.h"
+
+#ifndef SCHED_RESET_ON_FORK
+#define SCHED_RESET_ON_FORK 0x40000000
+#endif
+
+/* WINE_MMCSS: the plain boolean switch; WINE_MMCSS_RTPRIO: the base SCHED_FIFO priority (1-98, default 10) */
+static NTSTATUS mmcss_config( void *args )
+{
+    struct mmcss_config_params *params = args;
+    const char *value = getenv( "WINE_MMCSS" ), *base = getenv( "WINE_MMCSS_RTPRIO" );
+
+    params->enabled = value && (!strcmp( value, "1" ) || !strcasecmp( value, "true" ) ||
+                                !strcasecmp( value, "yes" ) || !strcasecmp( value, "on" ));
+    params->base = 10;
+    if (base)
+    {
+        char *end;
+        long n = strtol( base, &end, 10 );
+        if (end != base && !*end && n >= 1 && n <= 98) params->base = n;
+    }
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS mmcss_set( void *args )
+{
+#ifdef __linux__
+    struct mmcss_set_params *params = args;
+    struct sched_param param;
+
+    params->tid = syscall( SYS_gettid );
+    params->old_policy = sched_getscheduler( 0 );
+    params->old_prio = sched_getparam( 0, &param ) ? 0 : param.sched_priority;
+    param.sched_priority = params->prio;
+    /* threads this one starts do not inherit realtime scheduling */
+    params->error = sched_setscheduler( 0, SCHED_FIFO | SCHED_RESET_ON_FORK, &param ) ? errno : 0;
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
+static NTSTATUS mmcss_thread( void *args )
+{
+#ifdef __linux__
+    struct mmcss_thread_params *params = args;
+    struct sched_param param;
+    /* keep SCHED_RESET_ON_FORK: once set, an unprivileged thread may not clear it (EPERM), and it is harmless on
+     * the policy restored by AvRevertMmThreadCharacteristics */
+    int policy = (params->policy < 0 ? SCHED_FIFO : params->policy) | SCHED_RESET_ON_FORK;
+
+    param.sched_priority = params->prio;
+    params->error = sched_setscheduler( params->tid, policy, &param ) ? errno : 0;
+    return STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    mmcss_config,
+    mmcss_set,
+    mmcss_thread,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    mmcss_config,
+    mmcss_set,
+    mmcss_thread,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif  /* _WIN64 */
diff --git a/dlls/avrt/unixlib.h b/dlls/avrt/unixlib.h
new file mode 100644
index 0000000..6b4114e
--- /dev/null
+++ b/dlls/avrt/unixlib.h
@@ -0,0 +1,54 @@
+/*
+ * Unix side of avrt: MMCSS "Pro Audio" threads as Linux realtime threads
+ *
+ * Copyright 2026 ableton-linux contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "wine/unixlib.h"
+
+/* Every field is an int, so the layout is the same for 32-bit callers (the wow64 table reuses the functions). */
+
+struct mmcss_config_params
+{
+    int enabled;     /* out: WINE_MMCSS is a true value */
+    int base;        /* out: WINE_MMCSS_RTPRIO (1-98), 10 by default */
+};
+
+struct mmcss_set_params
+{
+    int prio;        /* in: the SCHED_FIFO priority for the calling thread */
+    int tid;         /* out: the calling thread's unix tid */
+    int old_policy;  /* out: its policy before (with SCHED_RESET_ON_FORK if it was set) */
+    int old_prio;    /* out: its priority before */
+    int error;       /* out: 0, or the errno of sched_setscheduler */
+};
+
+struct mmcss_thread_params
+{
+    int tid;         /* in: a unix tid of this process */
+    int policy;      /* in: the policy to apply, as sched_setscheduler takes it; -1: SCHED_FIFO, reset on fork */
+    int prio;        /* in */
+    int error;       /* out: 0, or errno */
+};
+
+enum avrt_funcs
+{
+    unix_mmcss_config,
+    unix_mmcss_set,
+    unix_mmcss_thread,
+    unix_funcs_count,
+};
