+/* Block deadline arithmetic shared by the backend, the telemetry report and
+ * the unit test.  Pure C: no PipeWire or Wine dependency. */
+#pragma once
+
+#include <stdint.h>
+
+/* Duration of nframes at rate in nanoseconds, rounded to nearest; 0 while the
+ * rate is unknown. */
+static inline uint64_t
+pipeasio_block_period_ns(uint32_t nframes, uint32_t rate)
+{
+    return rate ? ((uint64_t)nframes * 1000000000ull + rate / 2) / rate : 0;
+}
+
+/* PipeWire: clock.nsec is the start of the current cycle and clock.next_nsec
+ * the logical start of the next one, the data loop's next wakeup.  The host
+ * callback must return before it.  A position io without a usable next_nsec
+ * gets one period after the cycle start. */
+static inline uint64_t
+pipeasio_block_deadline_ns(uint64_t nsec, uint64_t next_nsec, uint32_t duration, uint32_t rate)
+{
+    return next_nsec > nsec ? next_nsec : nsec + pipeasio_block_period_ns(duration, rate);
+}
+
+/* Positive while the block ended before its deadline, negative by the amount
+ * it was late. */
+static inline int64_t
+pipeasio_block_slack_ns(uint64_t deadline_ns, uint64_t end_ns)
+{
+    return (int64_t)(deadline_ns - end_ns);
+}
