+++ b/tests/unit/test_block_clock.c
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "pipeasio_block_clock.h"
+#include "pipeasio_telemetry.h"
+#include "test_helpers.h"
+
+int
+main(void)
+{
+    TEST_GROUP("block period")
+    {
+        EXPECT_EQ(pipeasio_block_period_ns(64, 48000), 1333333u);
+        EXPECT_EQ(pipeasio_block_period_ns(128, 44100), 2902494u);
+        EXPECT_EQ(pipeasio_block_period_ns(1024, 48000), 21333333u);
+        EXPECT_EQ(pipeasio_block_period_ns(48000, 48000), 1000000000u);
+        EXPECT_EQ(pipeasio_block_period_ns(64, 0), 0u);
+        EXPECT_EQ(pipeasio_block_period_ns(0, 48000), 0u);
+    }
+
+    TEST_GROUP("deadline prefers next_nsec")
+    {
+        EXPECT_EQ(pipeasio_block_deadline_ns(1000, 2500, 64, 48000), 2500u);
+        /* No usable next_nsec: one period after the cycle start. */
+        EXPECT_EQ(pipeasio_block_deadline_ns(1000, 0, 64, 48000), 1334333u);
+        EXPECT_EQ(pipeasio_block_deadline_ns(1000, 1000, 64, 48000), 1334333u);
+        EXPECT_EQ(pipeasio_block_deadline_ns(1000, 999, 64, 48000), 1334333u);
+        EXPECT_EQ(pipeasio_block_deadline_ns(1000, 0, 64, 0), 1000u);
+        EXPECT_EQ(pipeasio_block_deadline_ns(0, 0, 0, 0), 0u);
+    }
+
+    TEST_GROUP("slack sign")
+    {
+        EXPECT_EQ(pipeasio_block_slack_ns(2000, 1500), 500);
+        EXPECT_EQ(pipeasio_block_slack_ns(2000, 2000), 0);
+        EXPECT_TRUE(pipeasio_block_slack_ns(2000, 2500) == -500);
+        EXPECT_TRUE(pipeasio_block_slack_ns(2000, 2500) < 0);
+        EXPECT_TRUE(pipeasio_block_slack_ns(0, 1) == -1);
+    }
+
+    TEST_GROUP("seq and slack round-trip through the ring")
+    {
+        pipeasio_telemetry_ring   ring;
+        pipeasio_telemetry_sample sample = { 0 };
+        uint64_t                  first;
+        pipeasio_telemetry_ring_init(&ring);
+        sample.seq                              = 123456789012ull;
+        sample.slack_ns                         = -42;
+        sample.wall_ns[PIPEASIO_TELEMETRY_LIVE] = 7;
+        sample.flags                            = PIPEASIO_TELEMETRY_TIME_INFO;
+        EXPECT_TRUE(pipeasio_telemetry_ring_publish(&ring, &sample));
+        EXPECT_EQ(pipeasio_telemetry_ring_snapshot(&ring, &first), 1u);
+        const pipeasio_telemetry_sample *stored = pipeasio_telemetry_ring_at(&ring, first);
+        EXPECT_EQ(stored->seq, 123456789012ull);
+        EXPECT_TRUE(stored->slack_ns == -42);
+        EXPECT_EQ(stored->wall_ns[PIPEASIO_TELEMETRY_LIVE], 7u);
+        EXPECT_EQ(stored->flags, PIPEASIO_TELEMETRY_TIME_INFO);
+        pipeasio_telemetry_ring_consume(&ring, first, 1);
+        EXPECT_EQ(pipeasio_telemetry_ring_snapshot(&ring, NULL), 0u);
+    }
+
+    return test_report();
+}
