+ * You should have received a copy of the GNU General Public License along with
+ * this program.  If not, see <https://www.gnu.org/licenses/>.
+ */
+
+/* Static trace points (USDT, provider "pipeasio") of the ELF driver halves. */
+#pragma once
+
+/*
+ * PIPEASIO_PROBE(name, args...) expands to one 5-byte nop in the instruction
+ * stream plus a .note.stapsdt ELF note that describes the argument locations.
+ * Nothing runs at the site until a tracer (bpftrace, libbpf) turns the nop
+ * into a uprobe for the processes it selects, so the probes are compiled in
+ * unconditionally and cost nothing while unattached.  List them with
+ *   readelf -n lib/wine/x86_64-unix/pipeasio64.dll.so
+ *   bpftrace -l 'usdt:/path/to/pipeasio64.dll.so:pipeasio:*'
+ *
+ * Probe contract (argument order; u32 arguments arrive as 4@, u64 as 8@):
+ *   cycle_start(clock_nsec u64, next_nsec u64, duration u32, position u64, flags u32)
+ *       audio_on_process entry: the PipeWire cycle's spa_io_clock fields.
+ *   cycle_end(missed u32, delivered u32)
+ *       audio_on_process exit: graph cycles the host missed before this one
+ *       (clock.position gap) and whether the host consumed this cycle.
+ *   block_start(seq u64, nframes u32, rate u32, clock_nsec u64, deadline_ns u64, flags u32)
+ *       process_callback once the host gate answered; flags are PIPEASIO_BLOCK_*.
+ *   block_before_live(seq u64) / block_after_live(seq u64)
+ *       immediately around the host's bufferSwitch / bufferSwitchTimeInfo call.
+ *   block_end(seq u64, flags u32, missed u32)
+ *       after every output was published, before the host gate is left.
+ *
+ * seq is the driver instance's block counter: 1 for its first callback, and
+ * 0 never occurs so a tracer can use it for "no block".  Every time is in
+ * CLOCK_MONOTONIC nanoseconds, the PipeWire graph clock domain.
+ *
+ * The mingw-built WoW64 PE front end (PIPEASIO_WOW64_PE) must never include
+ * sdt.h: PE has no .note.stapsdt and the mingw assembler lacks the section
+ * flags, so there the macro is a no-op.
+ */
+#if defined(__linux__) && !defined(PIPEASIO_WOW64_PE)
+#ifndef SDT_USE_VARIADIC
+#define SDT_USE_VARIADIC 1
+#endif
+#include "sdt.h"
+#define PIPEASIO_PROBE(name, ...) STAP_PROBEV(pipeasio, name, ##__VA_ARGS__)
+#else
+#define PIPEASIO_PROBE(name, ...) ((void)0)
+#endif
+
+/* block_start / block_end flag bits */
+#define PIPEASIO_BLOCK_ADMITTED 0x1u  /* the host gate admitted the callback */
+#define PIPEASIO_BLOCK_TIME_INFO 0x2u /* bufferSwitchTimeInfo carried the block */
+#define PIPEASIO_BLOCK_MUTED 0x4u     /* quantum mismatch: silence swapped both ways */
