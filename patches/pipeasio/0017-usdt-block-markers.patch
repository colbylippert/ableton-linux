--- a/include/audio.h
+++ b/include/audio.h
@@ -147,6 +147,20 @@ void audio_drop_force_quantum(audio_client_t *client);
  * 0 before the first cycle. Feeds the ASIO host's systemTime. */
 uint64_t audio_get_time_nsec(audio_client_t *client);
 
+/* Logical deadline of the most recent process cycle, in the graph clock domain
+ * of audio_get_time_nsec (CLOCK_MONOTONIC nanoseconds): the data loop's next
+ * wakeup (clock.next_nsec), or the cycle start plus one quantum when the
+ * daemon reports none.  0 before the first cycle of an activation.  The host
+ * callback must return before it; the block trace points and the telemetry
+ * slack measure against it (pipeasio-usdt-block-markers). */
+uint64_t audio_get_cycle_deadline_nsec(audio_client_t *client);
+
+/* Graph cycles the host was due but did not get between the previous process
+ * cycle and the current one: the clock.position gap, measured at cycle entry
+ * and only in steady state (quantum equal to the host buffer, same clock id).
+ * Meaningful during the process callback of that cycle. */
+uint32_t audio_get_cycle_missed(audio_client_t *client);
+
 /* Ports */
 
 audio_port_t *audio_port_register(audio_client_t *client, const char *port_name, uint64_t flags,
