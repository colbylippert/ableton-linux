{
  "schema": "ableton-linux-scenario/v1",
  "name": "clip-launch-storm",
  "kind": "benchmark",
  "base_set": "Benchmark_Inbuilts",
  "description": "Four MIDI clips created in setup on track 1 (Operator) and track 3 (Wavetable) are fired alternately every 500 ms with quarter-note launch quantization while the arrangement plays. The sets have no session clips; firing an empty scene would stop the arrangement on every track.",
  "requires": {
    "control_surface": true,
    "max_for_live": false,
    "plugins": []
  },
  "setup": [
    {
      "op": "stop"
    },
    {
      "op": "rewind"
    },
    {
      "op": "set_quantization",
      "quantization": 7
    },
    {
      "op": "create_clip",
      "track": 1,
      "clip": 0,
      "length": 4.0
    },
    {
      "op": "add_notes",
      "track": 1,
      "clip": 0,
      "notes": [
        [
