  "timeline": {
    "period_s": 2.0,
    "repeat": true,
    "marker_every_s": 5.0,
    "steps": [
      {
        "at_s": 0.0,
        "op": "fire_clip",
        "track": 1,
        "clip": 0
      },
      {
        "at_s": 0.5,
        "op": "fire_clip",
