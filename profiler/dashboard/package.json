{
  "name": "profiler-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gains-over-time dashboard for the Wine interface profiler. Reads profiler/history/runs/*.json, profiler/history/baselines.json and profiler/ledger.jsonl directly; no backend.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/lib.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
