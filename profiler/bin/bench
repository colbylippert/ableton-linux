#!/usr/bin/env bash
# profiler/bin/bench — scripts/bench-suite.sh the profiler way:
#   * AbletonOSC bench ports: ABL_BENCH_OSC_SEND=11000 ABL_BENCH_OSC_RECV=11001
#     (the canonical Sets keep their M4L device on 19001/19002; both may be
#     overridden in the environment)
#   * the desktop session environment via profiler/bin/with-session-env
#     (exit 3 without a DISPLAY)
#   * --output defaults to ~/.local/share/profiler/runs/<UTC>-<tag>/bench
#     (never inside the repo: build.sh snapshots every non-ignored file)
#   * ABLETON_WINE_ROOT is honoured (A/B against the dev runtime) and shown
#   * bare metal: before every run the audio node PipeASIO drives (audio_node=
#     in ~/.config/profiler/setup.conf — the built-in speaker sink with
#     --audio-device builtin) is muted again with `wpctl set-mute ID 1` when
#     setup phase audio recorded audio_mute=1 (builtin; a setup.conf without
#     audio_mute= mutes every node except profiler-null), so the real hardware
#     clock runs and nothing is heard; a configured node that is not in
#     PipeWire stops the run (exit 2), because PipeASIO would fall back to
#     another device and clock, and so does a PipeASIO config.ini whose
#     output_device is not that node (exit 2; `state restore` and setup phase
#     audio point it at audio_node). --no-audio-check skips this.
#   * a laptop (a Battery power supply) refuses to start on battery: the CPU
#     clocks and EPP follow the battery policy and the numbers are not
#     comparable (exit 2). --allow-battery overrides.
#   * the power profile ABLETON_POWER names (default performance; exported for
#     the launcher too) is held for the whole run. The launcher's own
#     `powerprofilesctl launch` hold is refused by polkit from an SSH session
#     (hold-profile is allow_active only), which left B4's runs on "balanced".
#     This hold runs in a `systemd-run --user --scope`, which polkit credits to
#     the user's graphical session; it ends with the run (and within 5 s when
#     the wrapper dies). A hold that does not take effect stops the run
#     (exit 2); ABLETON_POWER=off or --no-power-hold skips it.
#   * every other argument is forwarded unchanged — see scripts/bench-suite.sh
#     --help (--tag, --duration, --trace off|interface|drilldown, --scenario,
#     --sets, --dry-run, …); under the suite's --dry-run nothing is muted
#     (the mute is printed instead)
# The run directory is printed at the end, also after a failure or a dry run.
set -euo pipefail

here="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd -P)"
repo="$(cd -- "$here/../.." && pwd -P)"
suite="$repo/scripts/bench-suite.sh"
host_lib="$here/../setup/lib/host.sh"
runs_root="${PROFILER_SHARE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/profiler}/runs"
setup_conf="${PROFILER_SETUP_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/profiler/setup.conf}"

usage() {
    cat <<EOF
usage: profiler/bin/bench [--tag LABEL] [--output DIR] [--allow-battery] [--no-audio-check]
                          [bench-suite options...]

Wrapper around scripts/bench-suite.sh: exports ABL_BENCH_OSC_SEND=11000 and
ABL_BENCH_OSC_RECV=11001 (AbletonOSC bench handler) unless already set, runs the
suite inside the desktop session (with-session-env), defaults --output to
$runs_root/<UTC>-<tag>/bench
and prints the run directory at the end. ABLETON_WINE_ROOT selects the runtime.

Before every run it mutes the audio node PipeASIO drives (audio_node= in
$setup_conf), refuses when PipeASIO's output_device names another node and,
on a laptop, refuses to run on battery. It holds the ABLETON_POWER power
profile (default performance) for the whole run.
  --allow-battery     measure on battery anyway (numbers are not comparable)
  --no-audio-check    do not check or mute the audio node
  --no-power-hold     do not hold the power profile (ABLETON_POWER=off does the same)
Everything else is passed through; the suite's own help follows.

EOF
}

say() { printf 'bench: %s\n' "$*"; }
die() { printf 'bench: %s\n' "$*" >&2; exit "${2:-2}"; }
cfg() {   # KEY → last value in setup.conf ("" when absent)
    local line value=""
    [ -r "$setup_conf" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in "$1="*) value="${line#*=}" ;; esac
    done < "$setup_conf"
    printf '%s\n' "$value"
}

[ -x "$suite" ] || die "missing $suite"
[ -r "$host_lib" ] || die "missing $host_lib"
# shellcheck source=../setup/lib/host.sh
. "$host_lib"
# PipeWire (pw-cli, wpctl) needs the user's runtime dir, also from a bare SSH session
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export ABL_BENCH_OSC_SEND="${ABL_BENCH_OSC_SEND:-11000}"
export ABL_BENCH_OSC_RECV="${ABL_BENCH_OSC_RECV:-11001}"

tag=manual
output=""
allow_battery=0
audio_check=1
power_hold=1
suite_dry=0
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exec "$suite" --help ;;
        --tag) [ $# -ge 2 ] || die "--tag needs a value"; tag="$2"; args+=(--tag "$2"); shift ;;
        --tag=*) tag="${1#*=}"; args+=(--tag "$tag") ;;
        --output) [ $# -ge 2 ] || die "--output needs a value"; output="$2"; args+=(--output "$2"); shift ;;
        --output=*) output="${1#*=}"; args+=(--output "$output") ;;
        --allow-battery) allow_battery=1 ;;
        --no-audio-check) audio_check=0 ;;
        --no-power-hold) power_hold=0 ;;
        --dry-run) suite_dry=1; args+=("$1") ;;
        *) args+=("$1") ;;
    esac
    shift
done

# the suite's own tag sanitising, so the directory name matches its report label
safe_tag="$(printf '%s' "$tag" | tr -cs '[:alnum:]_.-' '-')"
safe_tag="${safe_tag#-}"; safe_tag="${safe_tag%-}"
[ -n "$safe_tag" ] || safe_tag=run
if [ -z "$output" ]; then
    run_dir="$runs_root/$(date -u +%Y%m%dT%H%M%SZ)-$safe_tag"
    output="$run_dir/bench"
    args+=(--output "$output")
else
    run_dir="$(dirname -- "$output")"
fi

# ------------------------------------------------------------- power ----
if host_has_battery; then
    say "power    $(host_power_summary)"
    if ! host_on_ac; then
        if [ "$allow_battery" -eq 1 ]; then
            say "WARNING: on battery (--allow-battery): CPU clocks and EPP follow the battery policy; these numbers are not comparable with runs on AC"
        else
            die "the laptop runs on battery: plug in the charger, or pass --allow-battery for a run whose numbers are not comparable"
        fi
    fi
fi

# The power hold and the trial-dialog watcher end with the wrapper.
watcher=""
power_unit=""
power_pid=""
cleanup() {
    [ -z "$watcher" ] || kill "$watcher" 2>/dev/null || true
    [ -z "$power_pid" ] || kill "$power_pid" 2>/dev/null || true
    [ -z "$power_unit" ] || timeout 10 systemctl --user stop "$power_unit.scope" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

current_profile() { timeout 5 powerprofilesctl get 2>/dev/null || echo '?'; }
power_profile="${ABLETON_POWER:-performance}"
case "$power_profile" in on|auto) power_profile=performance ;; esac
export ABLETON_POWER="$power_profile"
if [ "$power_hold" -eq 0 ] || [ "$power_profile" = off ]; then
    say "power    no profile hold (--no-power-hold or ABLETON_POWER=off); profile $(current_profile)"
elif ! command -v powerprofilesctl >/dev/null 2>&1; then
    say "WARNING: powerprofilesctl is not installed: no power profile hold (the governor and EPP below apply)"
elif [ "$power_profile" != performance ] && [ "$power_profile" != power-saver ]; then
    # power-profiles-daemon holds only performance and power-saver
    say "power    ABLETON_POWER=$power_profile: nothing to hold; profile $(current_profile)"
elif [ "$suite_dry" -eq 1 ]; then
    say "power    dry run: would hold '$power_profile' for the run (profile now $(current_profile))"
else
    hold=(powerprofilesctl launch -p "$power_profile" -r "profiler bench $safe_tag" -i profiler-bench --
          sh -c 'while kill -0 "$1" 2>/dev/null; do sleep 5; done' profiler-bench-hold "$$")
    if command -v systemd-run >/dev/null 2>&1 && timeout 5 systemctl --user show-environment >/dev/null 2>&1; then
        power_unit="profiler-bench-power-$$"
        systemd-run --user --scope --quiet --collect --unit="$power_unit" -- "${hold[@]}" >/dev/null 2>&1 &
    else
        "${hold[@]}" >/dev/null 2>&1 &
    fi
    power_pid=$!
    for _ in $(seq 1 20); do
        [ "$(current_profile)" != "$power_profile" ] || break
        kill -0 "$power_pid" 2>/dev/null || break
        sleep 0.5
    done
    [ "$(current_profile)" = "$power_profile" ] \
        || die "could not hold the '$power_profile' power profile (profile $(current_profile); powerprofilesctl launch failed or polkit refused it): the run would measure another CPU policy — check 'powerprofilesctl list', or pass --no-power-hold (ABLETON_POWER=off) for a run without the hold"
    say "power    holding '$power_profile' for the run${power_unit:+ (systemd user scope $power_unit)}"
fi
say "cpufreq  governor $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo '?'), EPP $(cat /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference 2>/dev/null || echo '?'), profile $(current_profile)"

# ------------------------------------------------------------- audio ----
audio_device="$(cfg audio_device)"
audio_node="$(cfg audio_node)"
audio_mute="$(cfg audio_mute)"     # 1|0 from setup phase audio; "" in an older setup.conf
if [ "$audio_check" -eq 1 ] && [ -z "$audio_node" ] && [ -n "$audio_device" ] && [ "$audio_device" != null ]; then
    audio_node="$(pwa_resolve_device "$audio_device" || true)"
    [ -z "$audio_node" ] || say "WARNING: audio_node is not recorded in $setup_conf (setup phase audio); --audio-device $audio_device resolves to $audio_node"
fi
if [ "$audio_check" -eq 0 ]; then
    say "audio    not checked (--no-audio-check)"
elif [ -z "$audio_node" ] || [ "$audio_node" = profiler-null ]; then
    say "audio    ${audio_node:-profiler-null} (virtual sink: nothing to mute)"
else
    pipeasio_ini="${XDG_CONFIG_HOME:-$HOME/.config}/pipeasio/config.ini"
    configured="$(sed -n 's/^[[:space:]]*output_device[[:space:]]*=[[:space:]]*//p' "$pipeasio_ini" 2>/dev/null | tail -n1 | sed 's/[[:space:]]*$//' || true)"
    [ "$configured" = "$audio_node" ] || die "PipeASIO's output_device is '${configured:-unset}', not $audio_node (audio_node= in $setup_conf): the run would measure another device and clock — fix $pipeasio_ini with setup-machine.sh --only audio (or state restore), or pass --no-audio-check"
    if ! node_id="$(pwa_node_id "$audio_node")"; then
        die "audio node $audio_node (audio_node= in $setup_conf) is not in PipeWire: PipeASIO would fall back to another device and clock — check wpctl status / setup-machine.sh --only audio, or pass --no-audio-check"
    fi
    if [ "$audio_mute" = 0 ]; then
        say "audio    $audio_node (id $node_id, $(pwa_mute_state "$audio_node")); not muted (audio_mute=0 in $setup_conf)"
    elif [ "$suite_dry" -eq 1 ]; then
        say "audio    $audio_node (id $node_id, $(pwa_mute_state "$audio_node")); dry run: would run  wpctl set-mute $node_id 1"
    else
        wpctl set-mute "$node_id" 1 || die "wpctl set-mute $node_id 1 failed for $audio_node"
        state="$(pwa_mute_state "$audio_node")"
        [ "$state" = muted ] || say "WARNING: $audio_node reports '$state' after wpctl set-mute"
        say "audio    $audio_node (id $node_id) muted"
    fi
fi

say "runtime  ${ABLETON_WINE_ROOT:-(configured default: ~/.config/ableton-wine/config or ~/.local/opt/wine-d2d1-nspa-11.13)}"
say "osc      send $ABL_BENCH_OSC_SEND / recv $ABL_BENCH_OSC_RECV"
say "output   $output"

# An unauthorised Trial shows a demo-mode dialog at every launch that blocks control
# surfaces until answered: answer it ("Save/Export Disabled") for the whole suite.
if [ "${PROFILER_NO_TRIAL_WATCH:-0}" != 1 ] && [ -x "$here/live-trial-dialog" ] && \
   ! printf '%s\n' ${args[@]+"${args[@]}"} | grep -qx -- '--dry-run'; then
    "$here/with-session-env" "$here/live-trial-dialog" watch --for 86400 >/dev/null 2>&1 &
    watcher=$!
    say "trial    demo-mode dialog watcher running (pid $watcher)"
fi

rc=0
"$here/with-session-env" "$suite" ${args[@]+"${args[@]}"} || rc=$?
say "run directory $run_dir (exit $rc)"
exit "$rc"
