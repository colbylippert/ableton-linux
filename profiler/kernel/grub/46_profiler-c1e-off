#!/bin/sh
# /etc/grub.d/46_profiler-c1e-off (from profiler/kernel/grub/, kernel-plan.md T0031): boot entries that turn C1E off
# before the operating system starts, after the other entries so no position shifts.
# MSR_POWER_CTL (0x1FC) bit 1 enables C1E. On this laptop it is one register for the whole CPU (clearing it on the boot
# CPU clears it on all 16), so GRUB's wrmsr, which runs on the boot CPU, covers every core. Windows has no setting for
# C1E and writing the register there takes a kernel driver; this needs neither. The other bits are kept: GRUB reads
# the register, clears bit 1 in the last hex digit and writes it back.
#   "Windows Boot Manager, C1E off (profiler)"   the os-prober Windows entry (template from install-c1e-off.sh)
#   "<normal title> (profiler: c1e-off)"          the normal linux-cachyos entry (template from install.sh)
# The register comes back on at every power-on and after sleep or hibernation. The default entry is never changed.
set -e
WIN=/etc/default/profiler-grub-windows-template
LIN=/etc/default/profiler-grub-template

c1e_off() {
    cat <<'GRUB'
	insmod rdmsr
	insmod wrmsr
	insmod regexp
	rdmsr 0x1fc -v profiler_pc
	regexp --set=profiler_pc_head '^(.*).$' "$profiler_pc"
	regexp --set=profiler_pc_last '(.)$' "$profiler_pc"
	if [ "$profiler_pc_last" = 2 ]; then profiler_pc_last=0
	elif [ "$profiler_pc_last" = 3 ]; then profiler_pc_last=1
	elif [ "$profiler_pc_last" = 6 ]; then profiler_pc_last=4
	elif [ "$profiler_pc_last" = 7 ]; then profiler_pc_last=5
	elif [ "$profiler_pc_last" = a ]; then profiler_pc_last=8
	elif [ "$profiler_pc_last" = b ]; then profiler_pc_last=9
	elif [ "$profiler_pc_last" = e ]; then profiler_pc_last=c
	elif [ "$profiler_pc_last" = f ]; then profiler_pc_last=d
	elif [ "$profiler_pc_last" = A ]; then profiler_pc_last=8
	elif [ "$profiler_pc_last" = B ]; then profiler_pc_last=9
	elif [ "$profiler_pc_last" = E ]; then profiler_pc_last=C
	elif [ "$profiler_pc_last" = F ]; then profiler_pc_last=D
	fi
	wrmsr 0x1fc "0x${profiler_pc_head}${profiler_pc_last}"
GRUB
}

if [ -r "$WIN" ]; then
    printf "menuentry 'Windows Boot Manager, C1E off (profiler)' --class windows --class os {\n"
    c1e_off
    sed -n '2,$p' "$WIN"
    printf '}\n'
fi
if [ -r "$LIN" ]; then
    title=$(sed -n '1s/^title=//p' "$LIN")
    if [ -n "$title" ]; then
        printf "menuentry '%s (profiler: c1e-off)' --class arch --class gnu-linux --class gnu --class os {\n" "$title"
        c1e_off
        sed -n '2,$p' "$LIN"
        printf '}\n'
    fi
fi
