 /*
+ * ntsync-live: the adaptive predictor (spin_adaptive). Each gated thread has a slot: its pid (22 bits), the outcomes
+ * of its last 4 gated waits (1 = short: over within spin_ns) and 16 two-bit saturating counters, one per history.
+ * A wait spins when the counter for the current history is at least 2, so a thread that alternates one long wait with
+ * a few short ones (Live's AudioCalc workers between and within audio blocks) spins only on the short ones. A slot that
+ * changes owner starts again with every counter at 2. Only the owning thread writes its slot.
+ */
+#define NTSL_PRED_BITS		6
+#define NTSL_PID_MASK		0x3fffffULL
+static u64 ntsl_pred[1 << NTSL_PRED_BITS];
+
+static u64 *ntsl_pred_slot(void)
+{
+	return &ntsl_pred[hash_32(current->pid, NTSL_PRED_BITS)];
+}
+
+static bool ntsl_predict(void)
+{
+	u64 v = READ_ONCE(*ntsl_pred_slot());
+	u32 hist = (v >> 32) & 15;
+
+	if ((v >> 42) != (current->pid & NTSL_PID_MASK))
+		return true;
+	return (((u32)v >> (hist * 2)) & 3) >= 2;
+}
+
+static void ntsl_learn(bool short_wait)
+{
+	u64 *slot = ntsl_pred_slot(), v = READ_ONCE(*slot);
+	u64 pid = current->pid & NTSL_PID_MASK;
+	u32 hist = 0, ctr = 0xaaaaaaaa, c;
+
+	if ((v >> 42) == pid) {
+		hist = (v >> 32) & 15;
+		ctr = (u32)v;
+	}
+	c = (ctr >> (hist * 2)) & 3;
+	if (short_wait && c < 3)
+		c++;
+	else if (!short_wait && c > 0)
+		c--;
+	ctr = (ctr & ~(3U << (hist * 2))) | (c << (hist * 2));
+	hist = ((hist << 1) | short_wait) & 15;
+	WRITE_ONCE(*slot, (pid << 42) | ((u64)hist << 32) | ctr);
+}
+
+/*
  * ntsync-live: may the current WAIT_ANY spin before it sleeps? Decided once per wait: spin_ns set, the thread
  * realtime (unless spin_rt is 0) and its name starting with one of the spin_comm prefixes.
  */
