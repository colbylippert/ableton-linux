ntsync-live: identity, parameters and statistics

MODULE_VERSION from the build (live-<series8>); spin_ns (clamped to 100 us), spin_rt, spin_comm
(RCU-published name prefixes); per-CPU counters in stats, zeroed by stats_reset. Nothing changes behaviour.

diff -ruN a/ntsync.c b/ntsync.c
--- a/ntsync.c	2026-10-19 11:06:41.857471590 -0400
+++ b/ntsync.c	2026-10-19 11:06:41.861305376 -0400
@@ -15,6 +15,8 @@
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/overflow.h>
+#include <linux/percpu.h>
+#include <linux/rcupdate.h>
 #include <linux/sched.h>
 #include <linux/sched/signal.h>
 #include <linux/slab.h>
@@ -24,6 +26,153 @@
 
 #define NTSYNC_NAME	"ntsync"
 
+/*
+ * ntsync-live: the Ableton Live profiler's ntsync (profiler/kernel/ntsync-live in the ableton-linux repository).
+ * Everything it adds is off by default: until a parameter is set the module behaves as upstream. It keeps the
+ * module name, the misc device, the uapi and the function names, so tools attached to them keep working.
+ */
+struct ntsl_stats {
+	u64 gated;	/* WAIT_ANY calls allowed to spin (spin_ns, spin_comm, spin_rt) */
+	u64 spins;	/* gated waits that reached the sleep with time left to spin */
+	u64 hits;	/* spins that ended because the wait was satisfied */
+	u64 misses;	/* spins that used their whole budget */
+	u64 aborts;	/* spins stopped early: need_resched, a signal, another runnable task */
+	u64 spin_ns;	/* time spent spinning */
+};
+static DEFINE_PER_CPU(struct ntsl_stats, ntsl_stats);
+
+#define NTSL_SPIN_NS_MAX	100000U
+#define NTSL_COMM_MAX		4
+
+struct ntsl_comm {
+	struct rcu_head rcu;
+	unsigned int n;
+	u8 len[NTSL_COMM_MAX];
+	char pfx[NTSL_COMM_MAX][TASK_COMM_LEN];
+};
+
+static unsigned int ntsl_spin_ns;
+static bool ntsl_spin_rt = true;
+static struct ntsl_comm __rcu *ntsl_comm;
+static DEFINE_MUTEX(ntsl_param_lock);
+
+static int ntsl_set_spin_ns(const char *val, const struct kernel_param *kp)
+{
+	unsigned int v;
+	int ret = kstrtouint(val, 0, &v);
+
+	if (ret)
+		return ret;
+	WRITE_ONCE(ntsl_spin_ns, min(v, NTSL_SPIN_NS_MAX));
+	return 0;
+}
+
+static const struct kernel_param_ops ntsl_spin_ns_ops = {
+	.set = ntsl_set_spin_ns,
+	.get = param_get_uint,
+};
+module_param_cb(spin_ns, &ntsl_spin_ns_ops, &ntsl_spin_ns, 0644);
+MODULE_PARM_DESC(spin_ns, "ntsync-live: spin up to this many ns before a gated WAIT_ANY sleeps (0 = off, at most 100000)");
+
+module_param_named(spin_rt, ntsl_spin_rt, bool, 0644);
+MODULE_PARM_DESC(spin_rt, "ntsync-live: only realtime (SCHED_FIFO/RR) threads may spin (default 1)");
+
+static int ntsl_set_spin_comm(const char *val, const struct kernel_param *kp)
+{
+	struct ntsl_comm *c, *old;
+	const char *p = val;
+	size_t n;
+
+	c = kzalloc(sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	while (*p && *p != '\n') {
+		n = strcspn(p, ",\n");
+		if (n == 0 || n >= TASK_COMM_LEN || c->n == NTSL_COMM_MAX) {
+			kfree(c);
+			return -EINVAL;
+		}
+		memcpy(c->pfx[c->n], p, n);
+		c->len[c->n++] = n;
+		p += n;
+		if (*p == ',')
+			p++;
+	}
+	mutex_lock(&ntsl_param_lock);
+	old = rcu_replace_pointer(ntsl_comm, c->n ? c : NULL, lockdep_is_held(&ntsl_param_lock));
+	mutex_unlock(&ntsl_param_lock);
+	if (!c->n)
+		kfree(c);
+	if (old)
+		kfree_rcu(old, rcu);
+	return 0;
+}
+
+static int ntsl_get_spin_comm(char *buf, const struct kernel_param *kp)
+{
+	const struct ntsl_comm *c;
+	unsigned int i;
+	int len = 0;
+
+	rcu_read_lock();
+	c = rcu_dereference(ntsl_comm);
+	for (i = 0; c && i < c->n; i++)
+		len += sysfs_emit_at(buf, len, "%s%.*s", i ? "," : "", c->len[i], c->pfx[i]);
+	rcu_read_unlock();
+	return len + sysfs_emit_at(buf, len, "\n");
+}
+
+static const struct kernel_param_ops ntsl_spin_comm_ops = {
+	.set = ntsl_set_spin_comm,
+	.get = ntsl_get_spin_comm,
+};
+module_param_cb(spin_comm, &ntsl_spin_comm_ops, NULL, 0644);
+MODULE_PARM_DESC(spin_comm, "ntsync-live: up to 4 comma-separated thread-name prefixes that may spin (empty = none)");
+
+static int ntsl_get_stats(char *buf, const struct kernel_param *kp)
+{
+	struct ntsl_stats sum = {};
+	int cpu;
+
+	for_each_possible_cpu(cpu) {
+		const struct ntsl_stats *s = per_cpu_ptr(&ntsl_stats, cpu);
+
+		sum.gated += READ_ONCE(s->gated);
+		sum.spins += READ_ONCE(s->spins);
+		sum.hits += READ_ONCE(s->hits);
+		sum.misses += READ_ONCE(s->misses);
+		sum.aborts += READ_ONCE(s->aborts);
+		sum.spin_ns += READ_ONCE(s->spin_ns);
+	}
+	return sysfs_emit(buf, "gated=%llu spins=%llu hits=%llu misses=%llu aborts=%llu spin_ns=%llu\n",
+			  sum.gated, sum.spins, sum.hits, sum.misses, sum.aborts, sum.spin_ns);
+}
+
+static const struct kernel_param_ops ntsl_stats_ops = {
+	.get = ntsl_get_stats,
+};
+module_param_cb(stats, &ntsl_stats_ops, NULL, 0444);
+MODULE_PARM_DESC(stats, "ntsync-live: counters since load or the last stats_reset");
+
+static int ntsl_set_stats_reset(const char *val, const struct kernel_param *kp)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		memset(per_cpu_ptr(&ntsl_stats, cpu), 0, sizeof(struct ntsl_stats));
+	return 0;
+}
+
+static const struct kernel_param_ops ntsl_stats_reset_ops = {
+	.set = ntsl_set_stats_reset,
+};
+module_param_cb(stats_reset, &ntsl_stats_reset_ops, NULL, 0200);
+MODULE_PARM_DESC(stats_reset, "ntsync-live: write anything to zero the counters");
+
+#ifdef NTSL_VERSION
+MODULE_VERSION(NTSL_VERSION);
+#endif
+
 enum ntsync_type {
 	NTSYNC_TYPE_SEM,
 	NTSYNC_TYPE_MUTEX,
