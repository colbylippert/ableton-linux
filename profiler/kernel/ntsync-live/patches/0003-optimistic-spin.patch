+/*
+ * ntsync-live: may the current WAIT_ANY spin before it sleeps? Decided once per wait: spin_ns set, the thread
+ * realtime (unless spin_rt is 0) and its name starting with one of the spin_comm prefixes.
+ */
+static bool ntsl_gate(void)
+{
+	const struct ntsl_comm *c;
+	bool ok = false;
+	unsigned int i;
+
+	if (likely(!READ_ONCE(ntsl_spin_ns)))
+		return false;
+	if (READ_ONCE(ntsl_spin_rt) && !rt_task(current))
+		return false;
+	rcu_read_lock();
+	c = rcu_dereference(ntsl_comm);
+	for (i = 0; c && i < c->n && !ok; i++)
+		ok = !strncmp(current->comm, c->pfx[i], c->len[i]);
+	rcu_read_unlock();
+	if (ok)
+		this_cpu_inc(ntsl_stats.gated);
+	return ok;
+}
+
+/*
+ * ntsync-live: spin, still TASK_RUNNING, until the wait is satisfied, the budget (spin_ns, clamped to the wait's
+ * own deadline) is spent, or something else needs this CPU. A waker that claims us while we spin finds us running,
+ * so its wake_up_process() returns at once. Whatever happens, ntsync_schedule() then runs its unchanged loop, which
+ * sets the task state and re-checks q->signaled before sleeping: no wake-up can be lost.
+ */
+static noinline void ntsl_spin_wait(const struct ntsync_q *q, const struct ntsync_wait_args *args)
+{
+	u64 budget = READ_ONCE(ntsl_spin_ns), start, end;
+	unsigned int i = 0;
+
+	if (args->timeout != U64_MAX) {
+		ktime_t deadline = ns_to_ktime(args->timeout), now;
+
+		if (args->flags & NTSYNC_WAIT_REALTIME) {
+			now = ktime_get_real();
+		} else {
+			deadline = timens_ktime_to_host(CLOCK_MONOTONIC, deadline);
+			now = ktime_get();
+		}
+		if (ktime_compare(deadline, now) <= 0)
+			return;		/* expired: a poll never spins */
+		budget = min_t(u64, budget, ktime_to_ns(ktime_sub(deadline, now)));
+	}
+	if (!budget)
+		return;
+	this_cpu_inc(ntsl_stats.spins);
+	start = local_clock();
+	end = start + budget;
+	for (;;) {
+		if (atomic_read_acquire(&q->signaled) != -1) {
+			this_cpu_inc(ntsl_stats.hits);
+			break;
+		}
+		if (need_resched() || signal_pending(current) || !single_task_running()) {
+			this_cpu_inc(ntsl_stats.aborts);
+			break;
+		}
+		if (!(++i & 15) && local_clock() >= end) {
+			this_cpu_inc(ntsl_stats.misses);
+			break;
+		}
+		cpu_relax();
+	}
+	this_cpu_add(ntsl_stats.spin_ns, local_clock() - start);
+}
+
 static int ntsync_schedule(const struct ntsync_q *q, const struct ntsync_wait_args *args)
 {
 	ktime_t timeout = ns_to_ktime(args->timeout);
